# ==============================================================================
# HISAB — Environment Variables
# Copy this file to `.env` in the project root (or backend/.env) and fill in
# real values. Never commit your actual .env file.
# ==============================================================================

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=hisab

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=60

# --- Email (SMTP) — used for OTP verification, password reset ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# --- Google OAuth (Social Login, Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloud storage (loan document uploads, Phase 2) ---
CLOUD_STORAGE_KEY=

# --- SMS / Twilio (mobile OTP & alerts, Phase 2) ---
TWILIO_SID=
TWILIO_TOKEN=

# --- Server ---
PORT=5000
FLASK_DEBUG=true

# Comma-free single origin (or "*" for local/demo). Restrict in production.
FRONTEND_ORIGIN=*
